{
  "name": "markdownreader",
  "private": true,
  "version": "2.0.2",
  "license": "MIT",
  "author": "lapisecek (Adam Kolařík)",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "tsc && node scripts/build-electron.cjs"
  },
  "build": {
    "appId": "com.adamk.markdownreader",
    "productName": "MarkdownReader",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown File",
        "role": "Editor",
        "icon": "icon.ico"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown File",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-highlight": "^3.27.2",
    "@tiptap/extension-image": "^3.27.2",
    "@tiptap/extension-link": "^3.27.2",
    "@tiptap/extension-subscript": "^3.27.2",
    "@tiptap/extension-superscript": "^3.27.2",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.2",
    "@tiptap/extension-task-list": "^3.27.2",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^6.0.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tiptap-markdown": "^0.9.0"
  }
}
